<Window x:Class="CCMixStudio.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCMixStudio" Height="860" Width="1440" MinHeight="640" MinWidth="1060"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Background="#F4F6FA" FontFamily="Segoe UI">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="250" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Content="Add .MIX files…" Click="AddFiles_Click" />
                    <Button Content="Extract All…" Click="ExtractAll_Click" />
                    <Button Content="Combine &amp; Export .MIX…" Click="ExportMix_Click" Background="#2F6BCE" Foreground="White" />
                    <Button Content="Import Names…" Click="ImportNames_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Duplicates" VerticalAlignment="Center" Margin="8,0,5,0" />
                    <ComboBox x:Name="DuplicatePolicy" Width="190" SelectedIndex="0" SelectionChanged="Options_Changed">
                        <ComboBoxItem Content="Overwrite with later archive" Tag="OverwriteLater" />
                        <ComboBoxItem Content="Keep first occurrence" Tag="KeepFirst" />
                        <ComboBoxItem Content="Keep all entries" Tag="KeepAll" />
                    </ComboBox>
                    <CheckBox x:Name="RaFlag" Content="RA/TS/RA2 header flag" VerticalAlignment="Center" Margin="12,0,8,0" Checked="Options_Changed" Unchecked="Options_Changed" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock Text="Loaded .MIX Queue" FontSize="17" FontWeight="SemiBold" />
                            <Button Content="Clear" Padding="8,3" DockPanel.Dock="Right" Click="Clear_Click" />
                        </DockPanel>
                        <TextBlock x:Name="QueueSummary" Foreground="#687386" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                    <ListBox x:Name="ArchiveList" ItemsSource="{Binding Archives}" SelectionChanged="ArchiveList_SelectionChanged" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E7EAF0" BorderThickness="0,0,0,1" Padding="5,8">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding FileName}" FontFamily="Consolas" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="🔓" Visibility="{Binding WasEncrypted, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="5,0,0,0" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Entries.Count, StringFormat={}{0} files}" Foreground="#687386" FontSize="12" />
                                        <TextBlock Text="{Binding Variant}" Foreground="#687386" FontSize="11" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <GroupBox DockPanel.Dock="Bottom" Header="Filename dictionary" Margin="0,10,0,0" Padding="8">
                        <StackPanel>
                            <TextBlock x:Name="DictionaryCount" Foreground="#687386" />
                            <TextBox x:Name="CrcInput" Text="RULES.INI" Margin="0,7,0,0" TextChanged="CrcInput_Changed" />
                            <TextBlock x:Name="CrcOutput" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </GroupBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBox x:Name="SearchBox" FontSize="14" Padding="8" Margin="0,0,0,8" ToolTip="Filter by name, CRC, type, or source" TextChanged="SearchBox_TextChanged" />
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="MergeSummary" Foreground="#687386" VerticalAlignment="Center" />
                            <Button Content="Expand selected nested .MIX" DockPanel.Dock="Right" Click="Expand_Click" />
                            <Button x:Name="UnexpandButton" Content="Unexpand selected .MIX" DockPanel.Dock="Right" Click="Unexpand_Click" IsEnabled="False" />
                            <Button Content="Remove selected archive" DockPanel.Dock="Right" Click="RemoveArchive_Click" />
                        </DockPanel>
                    </StackPanel>
                    <DataGrid x:Name="EntryGrid" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="EntryGrid_SelectionChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding DisplayLabel}" Width="2*" />
                            <DataGridTextColumn Header="CRC ID" Binding="{Binding HexId}" Width="120" />
                            <DataGridTextColumn Header="Type" Binding="{Binding DetectedType}" Width="130" />
                            <DataGridTextColumn Header="Source" Binding="{Binding SourceArchive}" Width="160" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,8">
                    <TextBlock Text="Asset Preview" FontSize="16" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <ComboBox x:Name="PalettePicker" Width="220" SelectionChanged="PalettePicker_SelectionChanged" />
                        <Button Content="◀" Click="PreviousFrame_Click" />
                        <TextBlock x:Name="FrameLabel" VerticalAlignment="Center" Margin="8,0" />
                        <Button Content="▶" Click="NextFrame_Click" />
                        <Button Content="Export frame/sheet…" Click="ExportImage_Click" />
                        <Button x:Name="PlaybackButton" Content="Play" Click="TogglePlayback_Click" />
                        <Button Content="Export WAV…" Click="ExportWav_Click" />
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="#EFF2F7" CornerRadius="5" ClipToBounds="True">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Image x:Name="PreviewImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </ScrollViewer>
                </Border>
                <StackPanel Grid.Column="1" Grid.Row="1" Margin="12,0,0,0">
                    <TextBlock x:Name="PreviewTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="PreviewDetails" Foreground="#687386" Margin="0,5,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="Drop .MIX archives anywhere in this window to add them." Foreground="#687386" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="StatusText" Foreground="#2C7A4B" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <TextBlock x:Name="ErrorText" Foreground="#B42318" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock Grid.Row="3" x:Name="FooterText" Foreground="#687386" FontSize="11" Margin="4,8,0,0" />
    </Grid>
</Window>
